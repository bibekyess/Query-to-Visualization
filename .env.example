# --- LLM provider ---
# LLM_PROVIDER selects which SDK drives the chatbot: openai | anthropic.
# (The /visualize agent always uses OpenAI.)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
# Only needed when LLM_PROVIDER=anthropic:
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8

# --- PubMed (NCBI E-utilities) ---
# Optional. Without a key you get 3 requests/second; with one, 10/second.
# NCBI_API_KEY=

# Logging
# DEBUG=true  -> human-readable console logs; false -> JSON logs
# LOG_LEVEL    -> DEBUG | INFO | WARNING | ERROR
# LOG_TIMEZONE -> IANA tz name for log timestamps (e.g. Asia/Seoul, UTC)
DEBUG=true
LOG_LEVEL=INFO
LOG_TIMEZONE=Asia/Seoul
